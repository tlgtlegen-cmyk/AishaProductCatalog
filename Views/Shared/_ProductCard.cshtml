@model AURA.Models.Product
<article class="product-card">
    <a class="product-image" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" aria-label="@Model.Name өнімін қарау">
        <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
        @if (Model.IsAvailable)
        {
            <span class="product-tag">Қолжетімді</span>
        }
        else
        {
            <span class="product-tag product-tag-muted">Қоймада жоқ</span>
        }
    </a>
    <div class="product-info">
        <div class="product-category">@Model.Category.Name</div>
        <div class="product-title-row">
            <h3><a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></h3>
            <span class="product-price">@Model.Price.ToString("N0") ₸</span>
        </div>
        <div class="product-card-bottom">
            @if (Model.IsAvailable)
            {
                <span class="availability"><i aria-hidden="true"></i> Қолжетімді</span>
            }
            else
            {
                <span class="availability unavailable"><i aria-hidden="true"></i> Қолжетімсіз</span>
            }
            <a class="product-link" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">
                Толығырақ <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</article>
